# Backend Server
PORT=3001
NODE_ENV=development

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Weather cache TTL in minutes (options: 5, 15, 30, 60; default: 15)
WEATHER_CACHE_TTL_MINUTES=15

# Alerts cache TTL in minutes (default: 5)
ALERTS_CACHE_TTL_MINUTES=5

# Frontend (prefix with REACT_APP_ for CRA / VITE_ for Vite)
REACT_APP_API_BASE_URL=http://localhost:3001/api

